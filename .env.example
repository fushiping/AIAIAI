# 服务
PORT=18930
NODE_ENV=production
# 反向代理后请填写实际访问域名，例如 https://vip.example.com
PUBLIC_ORIGIN=
# 部署在域名子目录时填写，例如 /vip/
APP_BASE_PATH=/
TRUST_PROXY=1

# 首次启动时创建总管理员；创建后修改 .env 不会重置已有密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=FushiVIP@2026
ADMIN_DISPLAY_NAME=超级管理员

# 可选：不配置时会在 data/.jwt-secret 自动生成并持久保存
JWT_SECRET=
SESSION_HOURS=12

# 上传与下载
MAX_PROJECT_FILE_MB=200
MAX_COVER_FILE_MB=5
