# Include this file inside an existing HTTPS server block.
# Replace __BASE_PATH__ with /vip and __PORT__ with the application port.
location = __BASE_PATH__ {
    return 301 __BASE_PATH__/;
}

location __BASE_PATH__/ {
    client_max_body_size 210m;
    proxy_pass http://127.0.0.1:__PORT__/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix __BASE_PATH__;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1800s;
    proxy_send_timeout 1800s;
    proxy_redirect off;
}
